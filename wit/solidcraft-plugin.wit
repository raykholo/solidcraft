package solidcraft:plugin@0.1.0;

// Initial command world, aligned with the interface proposal in PR #4980.
interface types {
    type json = string;
    variant plugin-error { failed(string), denied(string), limit(string), invalid(string) }
}
interface engine {
    use types.{json, plugin-error};
    run: func(command: string, args: json) -> result<json, plugin-error>;
}
interface log {
    enum level { debug, info, warn, error }
    log: func(level: level, message: string);
}
interface store {
    use types.{plugin-error};
    get: func(key: string) -> result<option<list<u8>>, plugin-error>;
    set: func(key: string, value: list<u8>) -> result<_, plugin-error>;
    remove: func(key: string) -> result<_, plugin-error>;
    keys: func() -> result<list<string>, plugin-error>;
    previous-version: func() -> option<string>;
}
interface command {
    use types.{json, plugin-error};
    execute: func(entry: string, params: json) -> result<json, plugin-error>;
}
/// File importers: one file's bytes in, a design out. An importer reads nothing else: the
/// host reads the file the user chose and hands over its contents, and the world grants no
/// files, network or engine commands.
interface importer {
    use types.{plugin-error};
    /// What an import produced.
    variant payload {
        /// A SolidCraft design container (the `.sc` file the app opens), so imported feature
        /// history stays editable.
        design(list<u8>),
        /// STEP text, for an importer that carries geometry only.
        step(list<u8>),
    }
    record imported {
        payload: payload,
        /// What did not come across, as plain text for the user (at most 64 KiB).
        notes: string,
    }
    /// Convert the file named `file-name` (its name only, without folders) from `bytes`.
    %import: func(file-name: string, bytes: list<u8>) -> result<imported, plugin-error>;
}
/// What the host tells an importer about the import it runs, and how the importer reports
/// how far it is. A component that does not import this interface still runs.
interface import-context {
    /// The step an import is on, as the app's progress shows it.
    enum stage { reading, decoding, mapping, writing }
    /// The options the user chose for this import, as a JSON object (`{}` when none): the
    /// values of the parameters the package's import command declares, checked by the host.
    options: func() -> string;
    /// The import is on `stage`, `done` of `total` units through it (`total` 0: unknown).
    /// Reporting never fails; after Cancel the host stops the importer at its next check.
    progress: func(stage: stage, done: u32, total: u32);
}
world command-plugin {
    import engine;
    import log;
    import store;
    export command;
}
world importer-plugin {
    import log;
    import import-context;
    export importer;
}
